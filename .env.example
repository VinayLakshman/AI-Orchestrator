APP_NAME=ai-orchestrator
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MAIN_MODEL=qwen3:14b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_VISION_MODEL=qwen2.5-vl:7b

KNOWLEDGE_SERVICE_URL=http://host.docker.internal:8001
KNOWLEDGE_RETRIEVE_PATH=/retrieve

MCP_GATEWAY_URL=
MCP_EXECUTE_PATH=/tools/execute

REQUEST_TIMEOUT_SECONDS=60
MAX_CONTEXT_CHUNKS=8
ENABLE_STREAMING=true
CORS_ALLOW_ORIGINS=*
